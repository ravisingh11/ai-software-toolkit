{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guardrails v2 Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject", "results"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 2},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision"],
      "properties": {
        "type": {"enum": ["git-commit", "artifact", "environment", "pull-request"]},
        "revision": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"}
      }
    },
    "results": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/providerResults"},
      "properties": {
        "change-scope": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "properties": {
            "repository-change-scope": {"$ref": "#/$defs/result"}
          },
          "additionalProperties": {"$ref": "#/$defs/plainResult"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80},
    "providerResults": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/plainResult"}
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "status"],
      "properties": {
        "producer": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
        "change_scope": {"$ref": "#/$defs/changeScope"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["passed", "failed"]}
            },
            "required": ["status"]
          },
          "then": {"required": ["evidence"]}
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["blocked", "not_run"]}
            },
            "required": ["status"]
          },
          "then": {"required": ["reason"]}
        },
        {
          "if": {"required": ["change_scope"]},
          "then": {
            "properties": {
              "status": {"enum": ["passed", "failed"]}
            }
          }
        }
      ]
    },
    "plainResult": {"allOf": [{"$ref": "#/$defs/result"}, {"not": {"required": ["change_scope"]}}]},
    "changeScope": {
      "description": "Optional display metrics; evaluator also validates arithmetic and status consistency.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "metrics", "thresholds"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "added_lines",
            "changed_lines",
            "max_added_lines_per_file",
            "binary_files",
            "total_files",
            "total_added_lines",
            "total_changed_lines",
            "excluded_files",
            "excluded_added_lines",
            "excluded_changed_lines",
            "excluded_binary_files"
          ],
          "properties": {
            "files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "added_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "changed_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "max_added_lines_per_file": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "binary_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "total_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "total_added_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "total_changed_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_added_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_changed_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_binary_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_files", "max_added_lines", "max_changed_lines", "max_added_lines_per_file"],
          "properties": {
            "max_files": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "max_added_lines": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "max_added_lines_per_file": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
          }
        }
      }
    }
  }
}
