{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Control Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "controls"],
  "properties": {
    "version": {"const": 2},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80},
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "stage", "availability", "evidence_subject", "enforcement_policy"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
        "stage": {"enum": ["change", "change-and-release", "pre-release", "release", "deployment", "post-deployment", "runtime"]},
        "availability": {"enum": ["runnable", "evidence-only"]},
        "evidence_subject": {"enum": ["git-commit", "artifact", "environment", "pull-request"]},
        "enforcement_policy": {"enum": ["promotable", "advisory-only"]}
      }
    }
  }
}
