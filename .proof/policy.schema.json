{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "profiles", "overrides"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 2},
    "name": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "release"],
      "properties": {
        "change": {"$ref": "#/$defs/overrides"},
        "release": {"$ref": "#/$defs/overrides"}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80},
    "overrides": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"enum": ["advisory", "enforced", "not_activated"]}
    }
  }
}
