{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject", "results"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 2},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision"],
      "properties": {
        "type": {"enum": ["git-commit", "artifact", "environment", "pull-request"]},
        "revision": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"}
      }
    },
    "results": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/providerResults"},
      "properties": {
        "change-scope": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "properties": {
            "repository-change-scope": {"$ref": "#/$defs/result"}
          },
          "additionalProperties": {"$ref": "#/$defs/plainResult"}
        },
        "pr-metadata": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "properties": {
            "repository-pr-metadata": {"$ref": "#/$defs/result"}
          },
          "additionalProperties": {"$ref": "#/$defs/plainResult"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80},
    "providerResults": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/plainResult"}
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "status"],
      "properties": {
        "producer": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
        "change_scope": {"$ref": "#/$defs/changeScope"},
        "pr_metadata": {"$ref": "#/$defs/prMetadata"},
        "check_execution": {"$ref": "#/$defs/checkExecution"},
        "measurements": {"$ref": "#/$defs/measurements"}
      },
      "allOf": [
        {
          "if": {"required": ["check_execution"]},
          "then": {"oneOf": [
            {"properties": {"status": {"const": "passed"}, "check_execution": {"properties": {"conclusion": {"const": "success"}}}}},
            {"properties": {"status": {"const": "failed"}, "check_execution": {"properties": {"conclusion": {"const": "failure"}}}}},
            {"properties": {"status": {"const": "blocked"}, "check_execution": {"properties": {"conclusion": {"enum": ["cancelled", "timed_out", "action_required", "stale"]}}}}},
            {"properties": {"status": {"const": "not_run"}, "check_execution": {"properties": {"conclusion": {"enum": ["neutral", "skipped"]}}}}}
          ]}
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["passed", "failed"]}
            },
            "required": ["status"]
          },
          "then": {"required": ["evidence"]}
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["blocked", "not_run"]}
            },
            "required": ["status"]
          },
          "then": {"required": ["reason"]}
        },
        {
          "if": {"required": ["measurements"]},
          "then": {
            "properties": {
              "status": {"enum": ["passed", "failed"]}
            }
          }
        },
        {
          "if": {"required": ["change_scope"]},
          "then": {
            "properties": {
              "status": {"enum": ["passed", "failed"]}
            }
          }
        },
        {
          "if": {"required": ["pr_metadata"]},
          "then": {
            "properties": {
              "status": {"enum": ["passed", "failed"]}
            }
          }
        }
      ]
    },
    "plainResult": {"allOf": [{"$ref": "#/$defs/result"}, {"not": {"required": ["change_scope"]}}, {"not": {"required": ["pr_metadata"]}}]},
    "measurements": {
      "description": "Optional self-reported display metrics from the pull request's own workflow run; they never change a result status. Evaluator also restricts each kind to its control (tests: unit-tests, coverage: changed-code-coverage, contracts: repository-validation, documentation: documentation-validation, documents: repository-ground-truth, migrations: migration-validation, review_findings: the four ai-*-review controls, findings: custom-static-analysis, secret-detection, deep-sast, and dependency-vulnerability) and checks arithmetic and status consistency; review_findings and findings are checked for arithmetic only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "source": {"const": "pull-request-workflow"},
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "skipped"],
          "properties": {
            "total": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "passed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "failed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "skipped": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measured_lines", "covered_lines", "threshold_percent"],
          "properties": {
            "measured_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "covered_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "threshold_percent": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "not_run"],
          "properties": {
            "total": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "passed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "failed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "not_run": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["markdown_files", "links_checked", "broken_links", "mapping_failures"],
          "properties": {
            "markdown_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "links_checked": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "broken_links": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "mapping_failures": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["declared", "found", "missing"],
          "properties": {
            "declared": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "found": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "missing": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked", "failed"],
          "properties": {
            "checked": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "failed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "review_findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "p0", "p1", "p2", "p3", "unresolved_blocking"],
          "properties": {
            "total": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "p0": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "p1": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "p2": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "p3": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "unresolved_blocking": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "critical", "high", "medium", "low", "unrated"],
          "properties": {
            "total": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "critical": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "high": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "medium": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "low": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "unrated": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        }
      },
      "oneOf": [{"required": ["tests"]}, {"required": ["coverage"]}, {"required": ["contracts"]}, {"required": ["documentation"]}, {"required": ["documents"]}, {"required": ["migrations"]}, {"required": ["review_findings"]}, {"required": ["findings"]}]
    },
    "checkExecution": {
      "description": "Optional completed-check facts. Evaluator also verifies timestamp validity, ordering, and duration arithmetic.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "started_at", "completed_at", "duration_seconds", "conclusion"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "started_at": {"$ref": "#/$defs/checkTimestamp"},
        "completed_at": {"$ref": "#/$defs/checkTimestamp"},
        "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "conclusion": {"enum": ["success", "failure", "cancelled", "timed_out", "action_required", "stale", "neutral", "skipped"]}
      }
    },
    "checkTimestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "prMetadata": {
      "description": "Optional trusted display detail from the base-branch PR metadata validator: a title predicate and section counts only, never PR text or section names. Evaluator also restricts it to pr-metadata.repository-pr-metadata and checks count and status consistency.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "title_matches", "required_sections", "missing_sections"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "title_matches": {"type": "boolean"},
        "required_sections": {"type": "integer", "minimum": 0, "maximum": 20},
        "missing_sections": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    },
    "changeScope": {
      "description": "Optional display metrics; evaluator also validates arithmetic and status consistency.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "metrics", "thresholds"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "added_lines",
            "changed_lines",
            "max_added_lines_per_file",
            "binary_files",
            "total_files",
            "total_added_lines",
            "total_changed_lines",
            "excluded_files",
            "excluded_added_lines",
            "excluded_changed_lines",
            "excluded_binary_files"
          ],
          "properties": {
            "files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "added_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "changed_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "max_added_lines_per_file": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "binary_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "total_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "total_added_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "total_changed_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_added_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_changed_lines": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "excluded_binary_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_files", "max_added_lines", "max_changed_lines", "max_added_lines_per_file"],
          "properties": {
            "max_files": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "max_added_lines": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "max_added_lines_per_file": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
          }
        }
      }
    }
  }
}
