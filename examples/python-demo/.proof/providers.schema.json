{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Providers",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers", "selections"],
  "properties": {
    "version": {"const": 2},
    "providers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/provider"}
    },
    "selections": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/selection"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80},
    "identifierList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_name", "workflow"],
      "oneOf": [
        {"required": ["workflow_path"]},
        {"required": ["app_slug"]}
      ],
      "properties": {
        "check_name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "workflow": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "workflow_path": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "trusted_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "app_slug": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
        "external_id_prefix": {"type": "string", "minLength": 1, "maxLength": 150, "pattern": "\\S"},
        "artifact_name_prefix": {"type": "string", "minLength": 1, "maxLength": 150, "pattern": "\\S"},
        "artifact_member": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._-]+$"}
      },
      "dependentRequired": {
        "trusted_paths": ["workflow_path"],
        "external_id_prefix": ["artifact_name_prefix", "artifact_member"],
        "artifact_name_prefix": ["external_id_prefix", "artifact_member"],
        "artifact_member": ["external_id_prefix", "artifact_name_prefix"]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_author"],
      "properties": {
        "review_author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\[bot\\])?$"
        }
      }
    },
    "provider": {
      "type": "object",
      "$comment": "The property names in checks and reviews must be disjoint; Proof semantic validation enforces this cross-object constraint.",
      "additionalProperties": false,
      "required": ["display_name", "activation", "capabilities", "checks", "template", "template_available", "secrets", "enabled_by_default"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "activation": {"enum": ["repository", "github", "external"]},
        "capabilities": {"$ref": "#/$defs/identifierList", "minItems": 1},
        "checks": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/check"}
        },
        "reviews": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/review"}
        },
        "template": {"type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "template_available": {"type": "boolean"},
        "secrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "enabled_by_default": {"type": "boolean"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative", "supplemental"],
      "properties": {
        "authoritative": {"$ref": "#/$defs/identifier"},
        "supplemental": {"$ref": "#/$defs/identifierList"}
      }
    }
  }
}
